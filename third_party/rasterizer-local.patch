 @property(weak) id <LayerDelegate> layerDelegate;
+
+// LOCAL MODIFICATION (see README-VENDORED.md; NOT upstream) — motion-blur feedback:
+// when > 0, each frame starts by compositing the PREVIOUS frame at this alpha over the
+// clear color (the Metal analog of zrender canvas/Layer.ts's back-buffer drawImage),
+// and ends by blitting the drawable into the persistent feedback texture.
+@property(nonatomic) double feedbackAlpha;
+// The retained previous frame (BGRA8, shared storage — CPU-readable) and the command
+// buffer of the most recent draw (for CPU readback synchronization).
+@property(nonatomic, readonly, nullable) id<MTLTexture> feedbackTexture;
+@property(nonatomic, readonly, nullable) id<MTLCommandBuffer> lastCommandBuffer;
+// Synchronous render (headless testing): unlike display, WAITS for an in-flight slot
+// instead of dropping the frame, and blocks until the GPU finishes.
+- (void)displayAndWait;
 @end
