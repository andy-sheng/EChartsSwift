{
  "id": "official-flame-graph-interactions",
  "demo": "official-flame-graph",
  "checks": [
    "Every hover frame must emphasize the requested flame block without permanently losing its text or changing unrelated block geometry; moving out must clear the temporary state.",
    "Each click must drill down on the same chart instance: the selected branch and its ancestors remain, its subtree expands to the available width, and unrelated branches disappear.",
    "The next target must be re-resolved by its stable data name after every drill-down; stale baseline coordinates are not acceptable evidence.",
    "After repeated drill-down, labels must be re-laid out and truncated inside their current rectangles without stale text, overlap, or missing wide-block labels.",
    "Clicking the rendered restore toolbox icon must restore the full root graph, including both separated upper branch clusters and the complete root/unix/genunix chain.",
    "Native and Web must agree on the semantic branch shown at every captured state; ignore font antialiasing and subpixel border differences."
  ],
  "steps": [
    {"action": "settle", "capture": "baseline"},

    {"action": "hoverData", "seriesIndex": 0, "dataName": "29509a5f-d6bc-47c9-8828-f93f5bc71d6b"},
    {"action": "settle", "capture": "hover-root"},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 200},
    {"action": "settle", "capture": "hover-root-restored"},

    {"action": "hoverData", "seriesIndex": 0, "dataName": "87f4e512-d5aa-47a0-be9f-93458bc76970"},
    {"action": "settle", "capture": "hover-unix-sys-syscall"},
    {"action": "clickData", "seriesIndex": 0, "dataName": "87f4e512-d5aa-47a0-be9f-93458bc76970", "movePointer": false},
    {"action": "settle", "capture": "drill-unix-sys-syscall"},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 700},
    {"action": "settle", "capture": "drill-unix-hover-cleared"},

    {"action": "hoverData", "seriesIndex": 0, "dataName": "f245eca3-a5c1-460d-a6d4-0e16f9f4dcc4"},
    {"action": "settle", "capture": "hover-genunix-open"},
    {"action": "clickData", "seriesIndex": 0, "dataName": "f245eca3-a5c1-460d-a6d4-0e16f9f4dcc4", "movePointer": false},
    {"action": "settle", "capture": "drill-genunix-open"},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 700},
    {"action": "settle", "capture": "drill-open-hover-cleared"},

    {"action": "hoverData", "seriesIndex": 0, "dataName": "9ccf9a48-f596-4087-bd18-5d223b5bf114"},
    {"action": "settle", "capture": "hover-genunix-fop-lookup"},
    {"action": "clickData", "seriesIndex": 0, "dataName": "9ccf9a48-f596-4087-bd18-5d223b5bf114", "movePointer": false},
    {"action": "settle", "capture": "drill-genunix-fop-lookup"},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 700},
    {"action": "settle", "capture": "drill-fop-lookup-hover-cleared"},

    {"action": "hoverData", "seriesIndex": 0, "dataName": "ca17bc13-9201-4055-9fd6-e24fcd19c32a"},
    {"action": "settle", "capture": "hover-lofs-lo-lookup"},
    {"action": "clickData", "seriesIndex": 0, "dataName": "ca17bc13-9201-4055-9fd6-e24fcd19c32a", "movePointer": false},
    {"action": "settle", "capture": "drill-lofs-lo-lookup"},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 700},
    {"action": "settle", "capture": "drill-lofs-hover-cleared"},

    {"action": "clickToolbox", "name": "restore", "movePointer": true},
    {"action": "pointerMove", "x": 1, "y": 1},
    {"action": "globalOut"},
    {"action": "wait", "milliseconds": 700},
    {"action": "settle", "capture": "final-restored"}
  ]
}
