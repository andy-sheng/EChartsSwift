# Upstream reference checkouts — large, reconstructed from upstream/upstream.lock
# via scripts/sync-upstream.sh. The lock file + README ARE tracked; the checkouts are not.
# (To vendor them instead — e.g. for offline builds — delete these lines.)
/upstream/echarts/
/upstream/zrender/
# ...including as SYMLINKS to another checkout (a trailing-slash pattern only matches directories).
/upstream/echarts
/upstream/zrender
# Defensive: never commit echarts prebuilt dist or any stray nested checkout under upstream/.
upstream/**/dist/
upstream/upstream/

# SwiftPM
/.build/
third_party/**/.build/
.swiftpm/

# Vendored Rasterizer checkout — reconstructed from third_party/rasterizer.lock +
# rasterizer-local.patch via scripts/sync-rasterizer.sh (like the upstream/ checkouts).
/third_party/Rasterizer/

# Independently versioned painter plugin (its own Git repository).
/RasterizerPainter/
/Examples/PainterGallery/.build/

# macOS / Xcode
.DS_Store
*.xcodeproj
*.xcworkspace

# DemoGallery staged .app (local dev/test artifact, built by scripts/build-demo-gallery.sh)
/build/

# Native-vs-web snapshot diff output (transient verification artifacts)
/out/

# Local editor / tool state + secrets (never commit)
.vscode/
.env
**/.archon/
**/.cursor/
**/.codebuddy/
**/.codex/

# Claude Code local config
.claude/
__pycache__/
